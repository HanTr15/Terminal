# ── Neon (PostgreSQL) ───────────────────────────────────────────────────────
# Ambil dari dashboard Neon -> Connection Details.
#
# DATABASE_URL : connection string DENGAN pooling. Wajib ada "-pooler" pada
#                host dan "?pgbouncer=true&connect_timeout=15" di akhir.
#                Dipakai aplikasi saat runtime.
# DIRECT_URL   : connection string TANPA pooling (host tanpa "-pooler").
#                Dipakai hanya oleh "prisma db push" / migrasi.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Opsional ────────────────────────────────────────────────────────────────
# URL publik situs setelah deploy, untuk thumbnail link (Open Graph).
NEXT_PUBLIC_SITE_URL=
